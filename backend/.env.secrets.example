# Secretos de las Edge Functions: copia a .env.secrets (no versionado) y carga con
#   supabase secrets set --env-file .env.secrets
MOCK_WEBHOOK_SECRET=
ENABLE_MOCK_PAY=true
CRON_SECRET=
MIN_AMOUNT_CENTS=500
ORDER_TTL_SECONDS=180
# Orígenes permitidos para CORS (coma). * = cualquiera. Los previews *.vercel.app de copiloto-zeroui se aceptan solos.
ALLOWED_ORIGINS=https://copiloto-zeroui.vercel.app,http://localhost:3000
# Nivel 4 (no usar en la demo)
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_BASE_URL=
