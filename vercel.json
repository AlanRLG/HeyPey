{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix tools/frontend ci",
  "buildCommand": "npm --prefix tools/frontend run build",
  "outputDirectory": "tools/frontend/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
